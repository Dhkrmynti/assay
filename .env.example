# Copy to .env and fill in. .env is ignored by git.

# Claude (pick one): an API key from console.anthropic.com → API Keys (starts with sk-ant-api03-)
ANTHROPIC_API_KEY=
# ...or leave it empty and run `ant auth login` once; the engine picks up that login by itself.

# Optional: which Claude model and how hard it thinks
# CLAUDE_MODEL=claude-opus-5-5        # or claude-sonnet-5-5, claude-haiku-5-5 (cheapest)
# CLAUDE_EFFORT=low                   # low | medium | high

# Optional: force a provider instead of auto-detect (claude | ollama)
# AI_PROVIDER=
